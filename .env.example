# Backend only; never prefix these with NEXT_PUBLIC_.
LOADIQ_API_BASE_URL=http://127.0.0.1:3001
LOADIQ_INTERNAL_API_KEY=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Two separate EU Sentry projects: backend and web. Empty disables monitoring.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# E2E flags are set only by scripts/e2e-server.mjs. Never configure in deployment.
